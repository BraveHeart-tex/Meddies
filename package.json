{
  "name": "meddies",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "22.x"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,jsx}": [
      "eslint --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,css}": "prettier --write --ignore-unknown"
  },
  "scripts": {
    "test": "pnpm worker:build && vitest run",
    "test:unit": "vitest run --project unit --project component",
    "test:integration": "pnpm worker:build && vitest run --project integration",
    "test:browser": "playwright test --project=phone --grep-invert @visual",
    "test:browser:build": "node scripts/test-browser-build.mjs",
    "test:browser:visual": "node scripts/test-browser-build.mjs --visual",
    "lint": "node scripts/check-architecture.mjs && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "next dev",
    "dev:stack": "node scripts/dev-stack.mjs",
    "build": "next build",
    "verify:local": "node scripts/verify.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && pnpm worker:typecheck",
    "prepare": "husky",
    "worker:build": "wrangler deploy --config worker/wrangler.jsonc --dry-run --outdir ../.worker-build",
    "worker:typecheck": "tsc -p worker/tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "^5.106.1",
    "@yudiel/react-qr-scanner": "2.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "next-auth": "5.0.0-beta.32",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "miniflare": "5.20261103.0-beta",
    "msw": "3.0.4",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vercel": "65.10.0",
    "vitest": "5.0.5",
    "wrangler": "4.157.0"
  }
}
