{
  "name": "meddies",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "22.x"
  },
  "lint-staged": {
    "*.{js,ts,json,cjs,mjs,md,css,tsx,jsx,json}": [
      "eslint .",
      "prettier . --write"
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3"
  }
}
