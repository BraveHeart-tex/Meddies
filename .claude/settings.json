{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-format-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting with ESLint layout fixes and Prettier"
          }
        ]
      }
    ]
  }
}
