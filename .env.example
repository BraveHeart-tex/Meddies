# Private server configuration only. Never use NEXT_PUBLIC_ for these values.
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
AUTH_ALLOWED_EMAIL=approved-account@example.com
# Increment and redeploy to invalidate every existing session.
AUTH_SESSION_VERSION=1

# Private medicine gateway; never use NEXT_PUBLIC_ prefixes.
MEDICINES_WORKER_URL=https://YOUR-WORKER.workers.dev
MEDICINES_WORKER_SECRET=replace-with-an-independent-random-secret-at-least-32-characters

# Release-only inventory. Configure in GitHub's production environment, not Vercel.
# Export explicitly for coordinated manual recovery; release.sh does not load dotenv.
CLOUDFLARE_API_TOKEN=replace-with-scoped-workers-and-d1-token
CLOUDFLARE_ACCOUNT_ID=replace-with-production-account-id
VERCEL_TOKEN=replace-with-scoped-deployment-token
VERCEL_ORG_ID=replace-with-vercel-team-id
VERCEL_PROJECT_ID=replace-with-vercel-project-id
PRODUCTION_APP_URL=https://YOUR-PUBLIC-PRODUCTION-DOMAIN
# Set true only after setup review; see docs/deployment.md.
RELEASE_SETUP_CONFIRMED=false

# CI-only inventory, set by the Verify workflow. Leave unset elsewhere: 1 disables the
# type check in next build.
# CI_SKIP_BUILD_TYPECHECK=
