# Private server configuration only. Never use NEXT_PUBLIC_ for these values.
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
AUTH_ALLOWED_EMAIL=approved-account@example.com
# Increment and redeploy to invalidate every existing session.
AUTH_SESSION_VERSION=1
