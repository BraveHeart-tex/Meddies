MEDICINES_WORKER_SECRET=replace-with-an-independent-random-secret-at-least-32-characters

# FCM sender for dose reminders. Local uses the separate Firebase project meddies-dev, the same
# project as the NEXT_PUBLIC_FIREBASE_* values in .env.local; production uses its own project.
# Copy from the service-account JSON key. FCM_PRIVATE_KEY is one double-quoted line with \n escapes.
FCM_PROJECT_ID=meddies-dev
FCM_CLIENT_EMAIL=replace-with-service-account@meddies-dev.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----\n"
