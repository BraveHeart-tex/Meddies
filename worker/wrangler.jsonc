{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "meddies-data",
  "main": "index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meddies",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
